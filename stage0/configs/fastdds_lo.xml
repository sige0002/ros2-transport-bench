<?xml version="1.0" encoding="UTF-8"?>
<!--
  Stage-0: pin Fast DDS to the network namespace's loopback only.
  UDPv4 whitelisted to 127.0.0.1 + builtin transports off, so (a) DDS can never
  leak onto the inter-namespace veth (the boundary byte counters then attribute
  every eth0 byte to the zenoh bridge session alone), and (b) the data path is
  UDP-loopback, making the kernel-buffer knob (rmem) the explicit lever exactly
  as in the production runbook. SHM is intentionally off for unambiguous
  accounting.
-->
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <profiles>
    <transport_descriptors>
      <transport_descriptor>
        <transport_id>lo_only_udp</transport_id>
        <type>UDPv4</type>
        <interfaceWhiteList>
          <address>127.0.0.1</address>
        </interfaceWhiteList>
      </transport_descriptor>
    </transport_descriptors>
    <participant profile_name="lo_only_participant" is_default_profile="true">
      <rtps>
        <userTransports>
          <transport_id>lo_only_udp</transport_id>
        </userTransports>
        <useBuiltinTransports>false</useBuiltinTransports>
      </rtps>
    </participant>
  </profiles>
</dds>
